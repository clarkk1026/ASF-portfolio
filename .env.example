# Groq API key for Bon chatbot (required on Vercel production)
GROQ_API_KEY=

# Optional — defaults to llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant

# Visitor notes (optional — enables persistent live counts across server restarts)
# Vercel Dashboard → Storage → Create Database → KV → Connect to this project
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
