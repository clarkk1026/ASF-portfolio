# Gemini API key for Bon chatbot (required on Vercel production)
GEMINI_API_KEY=

# Optional — defaults to gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# Visitor notes (optional — enables persistent live counts across server restarts)
# Vercel Dashboard → Storage → Create Database → KV → Connect to this project
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
