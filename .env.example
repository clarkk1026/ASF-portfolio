# Gemini API key for Bon chatbot (primary)
GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Groq API key (fallback when Gemini quota fails)
GROQ_API_KEY=

# Optional — defaults to llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Site passkey gate (required on Vercel — never put this in client code)
# Exact passkey visitors must enter
SITE_PASSKEY=Tomorrow

# Long random secret used to sign the unlock cookie (recommended)
# Generate one: openssl rand -hex 32
SITE_GATE_SECRET=

# Visitor notes — persistent live counts (pick one on Vercel)
# Option A: Vercel KV (recommended)
# Vercel Dashboard → Storage → Create Database → KV → Connect to this project
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Option B: Vercel Blob (auto-created when you add Blob storage to the project)
# BLOB_READ_WRITE_TOKEN=
# Optional — defaults to private (use public only for legacy public blob stores)
# BLOB_ACCESS=private
